# Required. The unprivileged role that owns the market schema.
DATABASE_URL=postgres://marketmanager:marketmanager@127.0.0.1:5432/eve?sslmode=disable

# Required. ESI etiquette: app name and a contact email.
USER_AGENT=marketmanager/1.0 (+https://example.com; ops@example.com)

# ESI. Pin the compatibility date and bump it deliberately.
ESI_BASE_URL=https://esi.evetech.net
X_COMPATIBILITY_DATE=2026-08-04

# Establishing a connection (TCP dial + TLS handshake). A connection that will
# not open is dead, so failing fast costs nothing.
ESI_CONNECT_TIMEOUT=5s
# A whole request including the body read. Deliberately generous: ESI's
# per-request latency swings from ~0.8s off-peak to ~15s at peak, and a
# client-side timeout does not cancel the server's work, so an impatient retry
# spends the token twice.
ESI_REQUEST_TIMEOUT=30s

# Fetch pacing. FETCH_RPS is the politeness contract and binds where latency is
# low; FETCH_CONCURRENCY binds where it is high. Whichever binds first, binds.
# ESI caps throughput per source IP: 16 in flight saturates that cap in every
# measured regime, and higher values only inflate per-request latency.
FETCH_RPS=70
FETCH_CONCURRENCY=16

# Budget governor, in ESI tokens. Below BUDGET_FLOOR the fetcher stops and probes
# for recovery. BUDGET_RESERVE is left unspent when deciding if a region fits.
BUDGET_RESERVE=600
BUDGET_FLOOR=300

# A single page is retried in place rather than failing the whole sweep. A page
# retry costs 2 tokens; discarding the sweep throws away every token already
# spent on the other pages, so this applies to all regions.
PAGE_ATTEMPTS=3
PAGE_BACKOFF_UNIT=250ms
# Retries stop while the legacy per-IP error budget is below this. Tripping it
# returns 420 on every route and blocks other applications on the same IP.
ERROR_LIMIT_FLOOR=30

# work_mem for the delta transaction. 64MB keeps its hash join to a single
# batch; 4MB spills and costs ~50% more, 256MB buys nothing.
DELTA_WORK_MEM=64MB

# debug, info, warn or error. Prod runs at info. debug adds a line per ESI
# request and per cycle phase, which is far too chatty for a live service.
LOG_LEVEL=info

HTTP_ADDR=:8080

# Error reporting (Bugsink, Sentry-SDK compatible). Unset here on purpose: a DSN
# is a write credential and never goes in git. An empty DSN makes every SDK call
# a no-op, so local development and CI stay silent with no extra settings. Prod
# gets it from Coolify as a runtime-only variable.
# BUGSINK_DSN=

INGEST_LOG_RETENTION_DAYS=30
PRUNE_INTERVAL=24h
# Separate from PRUNE_INTERVAL on purpose. Autovacuum never analyses a
# partitioned parent, so without this the planner has no statistics for the
# cross-region queries a consumer runs. Costs ~5s.
ANALYZE_INTERVAL=1h

# EVE Ref daily market history.
EVEREF_BASE_URL=https://data.everef.net/market-history
HISTORY_POLL_INTERVAL=15m
# How deep to backfill on first run. 730 days is ~36M rows before the tracked-
# region filter, ~25M after it.
HISTORY_BACKFILL_DAYS=730
# How far back to keep re-checking. A day file keeps growing for about four days;
# beyond this it is treated as final.
HISTORY_RECENT_DAYS=10
# Pause between day files, to stay polite to a best-effort third-party service.
HISTORY_SPACING=2s
